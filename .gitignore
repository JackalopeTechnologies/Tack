*.coveragexml

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# MSBuild logs
*.binlog

# JetBrains Rider
*.sln.iml
.idea/

# Scratch files for crafting commit messages and PR bodies at the repo root
/msg.txt
/pr-body.md

# dotenv files
.env

# OS files
.DS_Store
Thumbs.db
[Dd]esktop.ini

# Editor swap files
*.swp
*~

# VS Code (partial allow-list)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
